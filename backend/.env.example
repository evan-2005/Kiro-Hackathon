# Local Vision LLM Configuration (Ollama / OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen3-vl:4b
VISION_API_KEY=ollama

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Set to true to bypass live Qwen3-VL inference and return pre-computed fallback GeoJSON immediately
USE_FALLBACK_MOCK=false
